// zellij --layout claude   (or: zellij attach -c work --layout claude)
// One tab per Claude Code session, shell pane underneath for git/tests.
layout {
    tab name="claude" focus=true {
        pane split_direction="vertical" {
            pane name="claude" command="claude"
            pane name="shell" size="40%"
        }
    }
    tab name="scratch" {
        pane
    }
}

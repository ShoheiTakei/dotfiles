// Scroll is left at zellij's default: Ctrl s enters Scroll mode
// (j/k, Ctrl f/b, d/u, / to search, e to open the buffer in $EDITOR, Esc to exit).
//
// Ctrl b is unbound because Claude Code uses it to background tasks; the tmux-style
// mode lives on Ctrl a instead.
keybinds {
    unbind "Ctrl b"

    normal {
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        // Claude Code: Shift+Enter = newline. Terminals send CSI-u (ESC [ 13 ; 2 u)
        // but zellij only re-emits it to panes that negotiated the kitty protocol,
        // so write the bytes through unconditionally.
        bind "Shift Enter" { Write 27 91 49 51 59 50 117; }
    }

    // merges with the default tmux-mode binds:
    //   %  new pane right   "  new pane down   z fullscreen    x close pane
    //   h j k l focus       o next pane        c new tab       n p next/prev tab
    //   , rename tab        [ scroll mode      d detach        space next layout
    tmux {
        bind "Ctrl a" { SwitchToMode "Normal"; }

        // tmux muscle memory: | and - as aliases for % and "
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        // ToggleFloatingPanes only shows/hides existing floating panes, so `f`
        // spawns one and `F` toggles the whole floating layer.
        bind "f" { Run "zsh" { floating true; }; SwitchToMode "Normal"; }
        bind "F" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "w" { LaunchOrFocusPlugin "session-manager" { floating true; }; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
    }


}

// The session manager renders a single collapsed screen by default, and that screen
// binds no Right/Left at all -- the list stays at "N tabs, N panes" forever. Only the
// separate Attach screen, which multi_screen splits out (Tab cycles the screens),
// binds Right to expand a session into its tab and pane names. Expanding is the only
// way to read another session's tab names, which is where zellij-attention puts its
// icon, so this is what makes a detached session's state visible from here.
plugins {
    session-manager location="zellij:session-manager" {
        multi_screen "true"
    }
}

scroll_buffer_size 20000
copy_on_select false
show_startup_tips false
scrollback_editor "nvim"

// zellij-attention appends ⏳ / ✅ to the tab name when Claude Code needs input
// or finishes, and clears it when the pane is focused. The icon lives in the tab
// name itself, so `Ctrl a w` (session-manager) shows the state of tabs in the
// other sessions too -- which no sidebar plugin does; they only report a count.
//
// The plugin holds its state in memory and draws no pane of its own. The hooks
// that feed it are the Stop / Notification entries in ~/.claude/settings.json.
//
// Install (the .wasm is not tracked here):
//   mkdir -p ~/.config/zellij/plugins
//   curl -L https://github.com/KiryuuLight/zellij-attention/releases/download/v0.3.1/zellij-attention.wasm \
//     -o ~/.config/zellij/plugins/zellij-attention.wasm
load_plugins {
    "file:~/.config/zellij/plugins/zellij-attention.wasm"
}

// 0.45 defaults pane_frame_style to "titles", which spends a whole row on a
// title bar above each pane. "full" draws the border and puts the title in it.
pane_frame_style "full"
ui {
    pane_frames {
        rounded_corners true
    }
}

// Stacked panes otherwise render every collapsed pane's title as its own row
// across the top of the stack.
stacked_pane_list false
